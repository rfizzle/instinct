{
    "schemaVersion": 1,
    "id": "instinct",
    "version": "${version}",
    "name": "Instinct",
    "description": "A husbandry overhaul — pets with a survival instinct that grow veteran with age, livestock bloodlines worth breeding, herds that flock, a feeding trough, and a command whistle.",
    "authors": ["rfizzle"],
    "contact": {
        "homepage": "https://instinct.rfizzle.com",
        "sources": "https://github.com/rfizzle/instinct",
        "issues": "https://github.com/rfizzle/instinct/issues"
    },
    "license": "MIT",
    "icon": "assets/instinct/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["com.rfizzle.instinct.Instinct"],
        "client": ["com.rfizzle.instinct.client.InstinctClient"],
        "fabric-datagen": ["com.rfizzle.instinct.data.InstinctDataGenerator"],
        "fabric-gametest": [
            "com.rfizzle.instinct.gametest.SkeletonGameTest",
            "com.rfizzle.instinct.gametest.CoverageGameTest",
            "com.rfizzle.instinct.gametest.AttachmentPersistenceGameTest",
            "com.rfizzle.instinct.gametest.InstinctCommandGameTest",
            "com.rfizzle.instinct.gametest.MockPlayersGameTest",
            "com.rfizzle.instinct.gametest.SelfPreservationGameTest",
            "com.rfizzle.instinct.gametest.VeterancyGameTest",
            "com.rfizzle.instinct.gametest.RankBehaviorsGameTest",
            "com.rfizzle.instinct.gametest.GeneticsGameTest",
            "com.rfizzle.instinct.gametest.PerkBehaviorGameTest",
            "com.rfizzle.instinct.gametest.YieldGameTest",
            "com.rfizzle.instinct.gametest.BestInShowGameTest",
            "com.rfizzle.instinct.gametest.HerdingGameTest",
            "com.rfizzle.instinct.gametest.DownedGameTest",
            "com.rfizzle.instinct.gametest.FeedingTroughGameTest",
            "com.rfizzle.instinct.gametest.WhistleGameTest"
        ],
        "modmenu": [
            "com.rfizzle.instinct.compat.modmenu.ModMenuIntegration"
        ]
    },
    "mixins": [
        "instinct.mixins.json"
    ],
    "accessWidener": "instinct.accesswidener",
    "suggests": {
        "modmenu": "*",
        "jade": "*",
        "wthit": "*"
    },
    "depends": {
        "fabricloader": ">=0.16.10",
        "minecraft": "~1.21.1",
        "java": ">=21",
        "fabric-api": "*"
    }
}
