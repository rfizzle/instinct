# Instinct 16x16 command whistle — a copper pea-whistle with a bone mouthpiece.
# Rounded copper barrel with a round air-hole cut in the top, a pale bone mouthpiece
# tab on the left, and an ink silhouette outline. Light from top-left: copper
# highlight along the upper-left of the barrel, oxidized copper shadow lower-right.
size: 16

legend:
  @ #0a0a0a
  H #eaa477
  c #c17a4e
  o #86482c
  b #efe8d0
  n #b6ab89
  . transparent

frame:
  ................
  ................
  ................
  ................
  ......@@@.......
  ..@@@@@nn@@@@@..
  .@bbHccccccccc@.
  @bbbHccccccccco@
  @bbbnccccccccco@
  .@@nccccccccco@.
  ..@ooooooooo@@..
  ...@@@@@@@@@@...
  ................
  ................
  ................
  ................
