# Instinct 16x16 paw glyph — Jade/WTHIT and recipe-viewer contexts (no HUD slot).
# One broad pad, four toes, heart-rose ramp with an ink silhouette outline.
# Light from top-left: Rose Glow highlights left, shaded rose right/bottom.
size: 16

legend:
  @ #0a0a0a
  b #F5A8C8
  a #E5709B
  s #C25580
  d #98405F
  . transparent

frame:
  ................
  ....@@@..@@@....
  ....@b@..@b@....
  .@@@@a@..@a@@@@.
  .@b@@a@..@a@@s@.
  .@a@@@@..@@@@s@.
  .@a@........@s@.
  .@@@........@@@.
  ....@@@@@@@@....
  ...@bbaaaaas@...
  ..@baaaaaaass@..
  ..@baaaaaaass@..
  ..@aaaaaaaasd@..
  ...@aaaaaasd@...
  ....@@@@@@@@....
  ................
